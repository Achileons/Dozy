<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else in the app's Info.plist is generated by Xcode from
	  GENERATE_INFOPLIST_FILE and the INFOPLIST_KEY_* build settings, and is merged
	  on top of this file at build time. Only keys Xcode has no build setting for
	  belong here — UIAppFonts is one of them.

	  Each entry is the file name of a font in Resources/Fonts/. A font that is not
	  listed here is not registered, however present the file is.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>Quicksand-SemiBold.ttf</string>
		<string>Quicksand-Bold.ttf</string>
		<string>Nunito-Regular.ttf</string>
		<string>Nunito-SemiBold.ttf</string>
		<string>Nunito-Bold.ttf</string>
	</array>
</dict>
</plist>
